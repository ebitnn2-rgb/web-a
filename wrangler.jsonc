{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-a",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "25fec64e-ab54-4d9f-8111-63b17aa4c649","database_name": "web-a" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "16bea4f788a0491aa2db8123630d88d7" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
